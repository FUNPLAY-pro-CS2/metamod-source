# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
#
# Settings every platform shares -- AMBuild twin of makefiles/cmake/shared.cmake.
# The per-platform ones are in linux.ambuild / mac.ambuild / windows.ambuild.
# The CMake build only covers the Source 2 SDKs (Linux and Windows, x86_64),
# so what only Source 1 or 32-bit builds need has no CMake counterpart.
import os

# The compiler's flags, by its family (GCC / Clang, or MSVC), with the
# optimization and debugging flags after them. Runs before the platform file.
def ConfigureCompiler(cxx, options):
  if cxx.behavior == 'gcc':
    cxx.defines += [
      'stricmp=strcasecmp',
      '_stricmp=strcasecmp',
      '_snprintf=snprintf',
      '_vsnprintf=vsnprintf',
      'HAVE_STDINT_H',
      'GNUC',
    ]
    cxx.cflags += [
      '-pipe',
      '-fno-strict-aliasing',
      '-Wall',
      '-Werror',
      '-Wno-uninitialized',
      '-Wno-sign-compare',
      '-Wno-unused',
      '-Wno-switch',
      '-Wno-unknown-pragmas',
      '-Wno-dangling-else',
      '-msse',
      '-fPIC',
    ]

    cxx.cxxflags += ['-std=c++17']
    if (cxx.version >= 'gcc-4.0') or cxx.family == 'clang':
      cxx.cflags += ['-fvisibility=hidden']
      cxx.cxxflags += ['-fvisibility-inlines-hidden']
    cxx.cxxflags += [
      '-fno-exceptions',
      '-Wno-non-virtual-dtor',
      '-Wno-overloaded-virtual',
      '-Wno-register',
    ]
    if (cxx.version >= 'gcc-4.7' or cxx.family == 'clang'):
      cxx.cxxflags += ['-Wno-delete-non-virtual-dtor']
    if cxx.family == 'gcc':
      cxx.cflags += [
        '-mfpmath=sse',
        '-Wno-class-memaccess'
      ]
    if cxx.family == 'clang':
      cxx.cxxflags += ['-Wno-implicit-exception-spec-mismatch']
      if cxx.version >= 'clang-3.9' or cxx.version >= 'apple-clang-10.0':
        cxx.cxxflags += ['-Wno-expansion-to-defined']
      if cxx.version >= 'clang-3.6' or cxx.version >= 'apple-clang-7.0':
        cxx.cxxflags += ['-Wno-inconsistent-missing-override']
      if cxx.version >= 'apple-clang-5.1' or cxx.version >= 'clang-3.4':
        cxx.cxxflags += ['-Wno-deprecated-register']
      else:
        cxx.cxxflags += ['-Wno-deprecated']

    # Work around SDK warnings.
    if cxx.version >= 'clang-10.0' or cxx.version >= 'apple-clang-12.0':
      cxx.cflags += [
        '-Wno-implicit-int-float-conversion',
        '-Wno-tautological-overlap-compare',
      ]
    if cxx.version >= 'clang-13.0':
      cxx.cflags += [
        '-Wno-ordered-compare-function-pointers',
      ]

  elif cxx.like('msvc'):
    if options.debug == '1':
      cxx.cflags += ['/MTd']
      cxx.linkflags += ['/NODEFAULTLIB:libcmt']
    else:
      cxx.cflags += ['/MT']
    cxx.defines += [
      '_CRT_SECURE_NO_DEPRECATE',
      '_CRT_SECURE_NO_WARNINGS',
      '_CRT_NONSTDC_NO_DEPRECATE',
    ]
    cxx.cflags += [
      '/W3',
      '/Zi',
      '/EHsc',
      '/std:c++17',
    ]
    cxx.cxxflags += ['/TP']

    cxx.linkflags += [
      '/SUBSYSTEM:WINDOWS',
      'kernel32.lib',
      'user32.lib',
      'gdi32.lib',
      'winspool.lib',
      'comdlg32.lib',
      'advapi32.lib',
      'shell32.lib',
      'ole32.lib',
      'oleaut32.lib',
      'uuid.lib',
      'odbc32.lib',
      'odbccp32.lib',
    ]

  # Optimization
  if options.opt == '1':
    cxx.defines += ['NDEBUG']
    if cxx.behavior == 'gcc':
      cxx.cflags += ['-O3']
    elif cxx.behavior == 'msvc':
      cxx.cflags += ['/Ox', '/Zo']
      cxx.linkflags += ['/OPT:ICF', '/OPT:REF']

  # Debugging
  if options.debug == '1':
    cxx.defines += ['DEBUG', '_DEBUG']
    if cxx.behavior == 'gcc':
      cxx.cflags += ['-g3']
    elif cxx.behavior == 'msvc':
      cxx.cflags += ['/Od', '/RTC1']

  # Don't omit the frame pointer.
  # This needs to be after our optimization flags which could otherwise disable it.
  if cxx.behavior == 'gcc':
    cxx.cflags += ['-fno-omit-frame-pointer']
  elif cxx.behavior == 'msvc':
    cxx.cflags += ['/Oy-']

# Every compiler, after the platform file.
def ConfigureCxx(context, cxx, options, MMS):
  cxx.defines += [ 'MMS_USE_VERSIONLIB' ]
  cxx.includes += [
    os.path.join(context.sourcePath, 'public'),
    os.path.join(context.sourcePath, 'third_party', 'amtl'),
  ]
  if MMS.use_auto_versioning():
    cxx.defines += ['MMS_GENERATED_BUILD']
    cxx.includes += [
      os.path.join(context.buildPath, 'includes'),
      os.path.join(context.sourcePath, 'versionlib'),
    ]

# A metamod.<sdk> binary (MMS.HL2Library), before the SDK's SdkHelpers adds
# its includes, defines and libraries.
def ConfigureBinary(context, binary, sdk, MMS):
  cxx = binary.compiler
  cxx.cxxincludes += [
    os.path.join(context.currentSourcePath),
    os.path.join(context.sourcePath, 'loader'),
  ]

  # SE_<define>=<code> for every SDK of hl2sdk-manifests and s2sdk-manifests.
  for other_sdk in MMS.sdk_manifests:
    cxx.defines += ['SE_{}={}'.format(other_sdk['define'], other_sdk['code'])]

  if sdk['source2']:
    cxx.defines += ['META_IS_SOURCE2']
    # The same list, in the same order, as shared.cmake's MMS_SDK_SOURCES.
    binary.sources += [
      os.path.join(sdk['path'], 'public', 'tier0', 'memoverride.cpp'),
      os.path.join(sdk['path'], 'tier0_perproject', 'convar.cpp'),
    ]
