import os, sys

def ResolveEnvPath(env, folder):
  if env in os.environ:
    path = os.environ[env]
    if os.path.isdir(path):
      return path
  else:
    head = os.getcwd()
    oldhead = None
    while head != None and head != oldhead:
      path = os.path.join(head, folder)
      if os.path.isdir(path):
        return path
      oldhead = head
      head, tail = os.path.split(head)
  return None

# --hl2sdk-manifests / --s2sdk-manifests, else the submodule of the same name.
def ResolveManifests(option, submodule):
  path = getattr(builder.options, option, None) or os.path.join(builder.sourcePath, submodule)
  path = os.path.abspath(os.path.normpath(path))
  if not os.path.isfile(os.path.join(path, 'SdkHelpers.ambuild')):
    raise Exception('Could not find {0} in {1} (git submodule update --init?)'.format(submodule, path))
  return path

# Source 1 SDKs come from hl2sdk-manifests, the Source 2 ones (cs2, dota,
# deadlock) from s2sdk-manifests. hl2sdk-manifests still lists the Source 2
# games as well; they are filtered out of it, so no SDK is found twice.
HL2SdkHelpers = builder.Eval(os.path.join(ResolveManifests('hl2sdk_manifests', 'hl2sdk-manifests'), 'SdkHelpers.ambuild'), {
  'Project': 'metamod'
})
S2SdkHelpers = builder.Eval(os.path.join(ResolveManifests('s2sdk_manifests', 's2sdk-manifests'), 'SdkHelpers.ambuild'))

# The build settings, split the same way as the CMake side (makefiles/cmake/):
# shared.ambuild <-> shared.cmake, linux.ambuild <-> linux.cmake,
# windows.ambuild <-> windows.cmake, package.ambuild <-> package.cmake; the
# binaries' AMBuilders (core/, loader/) <-> CMakeBuilder.cmake. mac.ambuild has
# no twin: the CMake build (CMakeLists.txt) is for the Source 2 SDKs only,
# Source 1 builds with AMBuild.
Shared = builder.Import('makefiles/ambuild/shared.ambuild')
Platforms = {
  'linux': builder.Import('makefiles/ambuild/linux.ambuild'),
  'mac': builder.Import('makefiles/ambuild/mac.ambuild'),
  'windows': builder.Import('makefiles/ambuild/windows.ambuild'),
}

class MMSConfig(object):
  def __init__(self):
    self.sdk_manifests = []
    self.sdks = {}
    self.sdk_targets = []
    self.binaries = []
    self.generated_headers = None
    self.versionlib = None
    self.all_targets = []
    self.target_archs = set()
    self.libsafetyhook = {}
    self.libkhook = {}
    self.S2SdkHelpers = S2SdkHelpers

    if builder.options.targets:
      target_archs = builder.options.targets.split(',')
    else:
      target_archs = ['x86']
      if builder.backend == 'amb2':
        target_archs.append('x86_64')

    for arch in target_archs:
        try:
            cxx = builder.DetectCxx(target_arch = arch)
            self.target_archs.add(cxx.target.arch)
        except Exception as e:
            # Error if archs were manually overridden.
            if builder.options.targets:
                raise
            print('Skipping target {}: {}'.format(arch, e))
            continue
        self.all_targets.append(cxx)

    if not self.all_targets:
        raise Exception('No suitable C/C++ compiler was found.')

  def use_auto_versioning(self):
    if builder.backend != 'amb2':
      return False
    return not getattr(builder.options, 'disable_auto_versioning', False)

  def detectProductVersion(self):
    builder.AddConfigureFile('product.version')

    # For OS X dylib versioning
    import re
    with open(os.path.join(builder.sourcePath, 'product.version'), 'r') as fp:
      productContents = fp.read()
    m = re.match(r'(\d+)\.(\d+)\.(\d+).*', productContents)
    if m == None:
      self.productVersion = '1.0.0'
    else:
      major, minor, release = m.groups()
      self.productVersion = '{0}.{1}.{2}'.format(major, minor, release)

  # Source 1: <hl2sdk-root>/hl2sdk-<name>, HL2SDK<NAME>, or a hl2sdk-<name> folder above.
  def findSdkPath(self, sdk_name):
    dir_name = 'hl2sdk-{}'.format(sdk_name)
    if builder.options.hl2sdk_root:
      sdk_path = os.path.abspath(os.path.normpath(os.path.join(builder.options.hl2sdk_root, dir_name)))
      if os.path.exists(sdk_path):
        return sdk_path
    return ResolveEnvPath('HL2SDK{}'.format(sdk_name.upper()), dir_name)

  # Source 2: <hl2sdk-root>/hl2sdk-<name> (where checkout-deps puts s2sdk), the
  # manifest's env_vars (S2SDK_CS2, S2SDKCS2, S2SDK, HL2SDK_CS2, HL2SDKCS2 for
  # cs2; the first one set wins), or a hl2sdk-<name> folder above.
  def findS2SdkPath(self, sdk_name):
    dir_name = 'hl2sdk-{}'.format(sdk_name)
    if builder.options.hl2sdk_root:
      sdk_path = os.path.abspath(os.path.normpath(os.path.join(builder.options.hl2sdk_root, dir_name)))
      if os.path.exists(sdk_path):
        return sdk_path
    sdk_path = type(S2SdkHelpers).findSdkPathFromEnv(sdk_name)
    if sdk_path is not None and os.path.isdir(sdk_path):
      return sdk_path
    return ResolveEnvPath('HL2SDK{}'.format(sdk_name.upper()), dir_name)

  def shouldIncludeSdk(self, sdk):
    if sdk.get('source2', False) and self.productVersion.startswith('1.'):
      return False
    return True

  def detectSDKs(self):
    sdk_list = [s for s in builder.options.sdks.split(',') if s]
    s2_names = set(sdk['name'] for _, sdk in type(S2SdkHelpers).getSdks(None))
    keywords = [s for s in sdk_list if s in ['all', 'present']]
    hl2_list = keywords + [s for s in sdk_list if s not in keywords and s not in s2_names]
    s2_list = keywords + [s for s in sdk_list if s in s2_names]

    HL2SdkHelpers.sdk_filter = lambda sdk: sdk['name'] not in s2_names and self.shouldIncludeSdk(sdk)
    HL2SdkHelpers.find_sdk_path = self.findSdkPath
    S2SdkHelpers.sdk_filter = self.shouldIncludeSdk
    S2SdkHelpers.find_sdk_path = self.findS2SdkPath

    for helpers, names in [(HL2SdkHelpers, hl2_list), (S2SdkHelpers, s2_list)]:
      try:
        helpers.findSdks(builder, self.all_targets, names)
      except Exception as e:
        # With "all" or "present", one of the two may have nothing to build;
        # whether anything was found at all is checked below.
        if not keywords or not str(e).startswith('No buildable SDKs'):
          raise

    self.sdks = dict(HL2SdkHelpers.sdks)
    self.sdks.update(S2SdkHelpers.sdks)
    self.sdk_targets = HL2SdkHelpers.sdk_targets + S2SdkHelpers.sdk_targets
    if sdk_list and not self.sdk_targets:
      raise Exception('No buildable SDKs were found, nothing to build.')

    # Every SDK of both manifests, for the SE_<define>=<code> table. A game in
    # both has to have the same code and define in each.
    by_name = {}
    for sdk in HL2SdkHelpers.sdk_manifests + S2SdkHelpers.sdk_manifests:
      other = by_name.get(sdk['name'])
      if other is None:
        by_name[sdk['name']] = sdk
        self.sdk_manifests.append(sdk)
      elif (other['code'], other['define']) != (sdk['code'], sdk['define']):
        raise Exception('{0}: hl2sdk-manifests has SE_{1}={2}, s2sdk-manifests SE_{3}={4}'.format(
          sdk['name'], other['define'], other['code'], sdk['define'], sdk['code']))

  # The SdkHelpers the SDK was found with.
  def SdkHelpers(self, sdk):
    if sdk['name'] in S2SdkHelpers.sdks:
      return S2SdkHelpers
    return HL2SdkHelpers

  def Platform(self, cxx):
    if cxx.target.platform not in Platforms:
      raise Exception('Unsupported target platform: {0}'.format(cxx.target.platform))
    return Platforms[cxx.target.platform]

  def configure(self):
    builder.AddConfigureFile('pushbuild.txt')

    for cxx in self.all_targets:
      if cxx.target.arch not in ['x86', 'x86_64']:
        raise Exception('Unknown target architecture: {0}'.format(cxx.target.arch))

      self.configure_cxx(cxx)

  def configure_cxx(self, cxx):
    # shared.ambuild's compiler flags (by compiler family, with optimization
    # and debugging), the platform file, then what every platform gets last.
    Shared.ConfigureCompiler(cxx, builder.options)
    self.Platform(cxx).ConfigureCxx(cxx, builder.options)
    Shared.ConfigureCxx(builder, cxx, builder.options, self)

  def AddVersioning(self, binary):
    if binary.compiler.target.platform == 'windows':
      binary.sources += ['version.rc']
      binary.compiler.rcdefines += [
        'BINARY_NAME="{0}"'.format(binary.outputFile),
        'RC_COMPILE'
      ]
    elif binary.compiler.target.platform == 'mac' and binary.type == 'library':
      binary.compiler.postlink += [
        '-compatibility_version', '1.0.0',
        '-current_version', self.productVersion
      ]
    if self.use_auto_versioning():
      binary.compiler.linkflags += [self.versionlib[binary.compiler.target.arch]]
      binary.compiler.sourcedeps += MMS.generated_headers
    if builder.options.breakpad_dump:
      binary.compiler.symbol_files = 'separate'
    return binary

  def Library(self, cxx, name):
    binary = cxx.Library(name)
    self.AddVersioning(binary)

    if binary.compiler.like('gcc'):
      binary.sources += [
        os.path.join(builder.sourcePath, 'third_party', 'amtl', 'compat', 'stdcxx.cpp')
      ]

    return binary

  def Program(self, compiler, name):
    binary = compiler.Program(name)
    compiler = binary.compiler

    self.AddVersioning(binary)
    if '-static-libgcc' in binary.compiler.linkflags:
      binary.compiler.linkflags.remove('-static-libgcc')
    if '-lgcc_eh' in binary.compiler.linkflags:
      binary.compiler.linkflags.remove('-lgcc_eh')
    if binary.compiler.like('gcc'):
      binary.compiler.linkflags += ['-lstdc++']
    return binary

  def StaticLibrary(self, cxx, name):
    return cxx.StaticLibrary(name)

  def HL2Library(self, context, compiler, name, sdk):
    binary = self.Library(compiler, name)
    Shared.ConfigureBinary(context, binary, sdk, self)
    self.SdkHelpers(sdk).configureCxx(context, binary, sdk)
    return binary

if getattr(builder, 'target', None) is not None:
    sys.stderr.write("Your output folder was configured for AMBuild 2.1, and Metamod:Source\n")
    sys.stderr.write("is now configured to use AMBuild 2.2. Please remove your output folder\n")
    sys.stderr.write("and reconfigure to continue.\n")
    os._exit(1)

MMS = MMSConfig()
MMS.detectProductVersion()
MMS.configure()
MMS.detectSDKs()

if MMS.use_auto_versioning():
  MMS.generated_headers = builder.Build(
    'support/buildbot/Versioning',
    { 'MMS': MMS }
  )
  MMS.versionlib = builder.Build(
    'versionlib/AMBuildScript',
    { 'MMS': MMS }
  )

# The binaries keep their per-folder AMBuilders (loader/, core/).
BuildScripts = [
  'loader/AMBuilder',
  'core/AMBuilder',
]
if getattr(builder.options, 'enable_tests', False):
    BuildScripts += [
        'loader/test/AMBuilder',
    ]

if builder.backend == 'amb2':
  BuildScripts += [
    'makefiles/ambuild/package.ambuild',
  ]

builder.Build(['third_party/khook/AMBuilder', 'third_party/khook/third_party/safetyhook/AMBuilder'], { 'KHook': MMS, 'SafetyHook': MMS })
builder.Build(BuildScripts, { 'MMS': MMS })

if builder.options.breakpad_dump:
  builder.Build('support/buildbot/BreakpadSymbols', { 'MMS': MMS })
